# Connector setup card — configuration.
#
# Every string the card renders derives from these. Nothing about a deployment
# is compiled in, so the same build serves staging and production.
#
# Each name is also accepted with a VITE_ / PUBLIC_ / REACT_APP_ prefix, or
# with no prefix at all on a server-rendered page. Use whichever your framework
# exposes to the browser — the values below are all public by nature.

# Shown in the host's connector list, and used as the server key in .mcp.json.
NEXT_PUBLIC_MCP_SERVER_NAME="Your app"

# The origin that serves BOTH POST /mcp and /.well-known/oauth-protected-resource.
# No trailing slash. On Convex this is the *.convex.site host — the .cloud one
# answers 404 on /mcp.
NEXT_PUBLIC_MCP_ORIGIN="https://mcp.example.com"

# Space- or comma-separated. Must match what your protected-resource document
# advertises, or ChatGPT will request a scope your server then rejects.
NEXT_PUBLIC_MCP_SCOPES="mcp.read mcp.write"

# "true" when the server implements RFC 7591 dynamic client registration.
# This one flag decides whether both host forms leave the client fields empty
# or turn them into paste targets, so getting it wrong is user-visible.
NEXT_PUBLIC_MCP_DCR="true"

# --- optional ---------------------------------------------------------------

# Defaults to /mcp. ChatGPT requires the path explicitly; it is not inferred.
# NEXT_PUBLIC_MCP_PATH="/mcp"

# One line, shown in ChatGPT's optional Description field.
# NEXT_PUBLIC_MCP_DESCRIPTION="Read and update your account by chat"

# Only read when MCP_DCR is false. There is deliberately no CLIENT_SECRET here:
# anything this component can read has already shipped to the browser.
# NEXT_PUBLIC_MCP_CLIENT_ID=""

# "true" only if you actually serve /.well-known/openid-configuration. Almost
# nobody does, and MCP does not need it — leaving this off is the normal state.
# NEXT_PUBLIC_MCP_OIDC="false"
